<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <p class="site-footer__logo">Wie</p>
      <p class="site-footer__tagline">{{ site.tagline }}</p>
    </div>

    <nav class="site-footer__nav" aria-label="フッターナビゲーション">
      <ul>
        <li><a href="{{ '/about/' | url }}">Wieについて</a></li>
        <li><a href="{{ '/activities/' | url }}">活動内容</a></li>
        <li><a href="{{ '/projects/' | url }}">プロジェクト</a></li>
        <li><a href="{{ '/join/' | url }}">参加する</a></li>
        <li><a href="{{ '/news/' | url }}">お知らせ</a></li>
        <li><a href="{{ '/contact/' | url }}">お問い合わせ</a></li>
        <li><a href="{{ '/privacy/' | url }}">プライバシーポリシー</a></li>
      </ul>
    </nav>

    <div class="site-footer__side">
      {# 発信: note・SNS（src/_data/site.json の "sns"）・ラジオ。URL が未設定のものは表示されません #}
      <p class="site-footer__media-title">発信</p>
      <ul class="site-footer__sns">
        {% if links.NOTE_URL %}<li><a href="{{ links.NOTE_URL }}" target="_blank" rel="noopener noreferrer">note<span class="visually-hidden">（外部サイトへ移動します）</span></a></li>{% endif %}
        {% for s in site.sns %}
          {% if s.url %}
          <li><a href="{{ s.url }}" target="_blank" rel="noopener noreferrer">{{ s.label }}<span class="visually-hidden">（外部サイトへ移動します）</span></a></li>
          {% endif %}
        {% endfor %}
        {% if links.RADIO_URL %}<li><a href="{{ links.RADIO_URL }}" target="_blank" rel="noopener noreferrer">ラジオ<span class="visually-hidden">（外部サイトへ移動します）</span></a></li>{% endif %}
      </ul>
    </div>
  </div>

  <div class="site-footer__bottom">
    <p>&copy; {{ "" | year }} Wie</p>
  </div>
</footer>
