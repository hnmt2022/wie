{% from "partials/media.njk" import photo, illustration, itemMedia %}

{# 現在の活動：4つの柱カード #}
{% macro pillarCard(pillar, linkUrl) %}
<article class="card">
  {{ illustration(pillar.image, pillar.title, "1/1", false, pillar.recommendedImage) }}
  <div class="card__body">
    <h3 class="card__title">{{ pillar.title }}</h3>
    <p class="card__text">{{ pillar.summary }}</p>
    <a class="card__link" href="{{ linkUrl | url }}">詳しく見る<span class="visually-hidden">：{{ pillar.title }}</span></a>
  </div>
</article>
{% endmacro %}

{# トップ「Wieの活動」用のコンパクトな行（小さな画像＋タイトル＋短い説明） #}
{% macro pillarRow(pillar, linkUrl) %}
<a class="pillar-row" href="{{ linkUrl | url }}">
  <img class="pillar-row__img" src="{{ ('/images/generated/' + pillar.image) | url }}" alt="" loading="lazy" decoding="async">
  <span class="pillar-row__body">
    <span class="pillar-row__title">{{ pillar.title }}</span>
    <span class="pillar-row__text">{{ pillar.short or pillar.summary }}</span>
  </span>
  <span class="pillar-row__arrow" aria-hidden="true">→</span>
</a>
{% endmacro %}

{# 最近の活動・実績カード（日付や人数は未提供のため表示しない） #}
{% macro activityCard(item) %}
<article class="card card--compact">
  {{ photo(item.image, item.title, "4/3", false) }}
  <div class="card__body">
    <p class="card__eyebrow">{{ item.category }}</p>
    <h3 class="card__title card__title--sm">{{ item.title }}</h3>
  </div>
</article>
{% endmacro %}

{# 外部LP・noteへの導線カード。url が null なら「準備中」で非活性表示 #}
{% macro externalCard(title, description, url, ctaLabel) %}
<div class="card card--external">
  <div class="card__body">
    <h3 class="card__title card__title--sm">{{ title }}</h3>
    <p class="card__text">{{ description }}</p>
    {% if url %}
    <a class="btn btn--outline" href="{{ url }}" target="_blank" rel="noopener noreferrer">{{ ctaLabel }}<span class="visually-hidden">（外部サイトへ移動します）</span></a>
    {% else %}
    <span class="btn btn--outline btn--disabled" aria-disabled="true">{{ ctaLabel }}（準備中）</span>
    {% endif %}
  </div>
</div>
{% endmacro %}

{# お知らせカード。url があればタイトルをリンクに、tags は /news/?tag= への絞り込みリンク、sample が true なら「サンプル」バッジを表示 #}
{% macro newsCard(n) %}
<article class="card card--compact" data-tags="{{ (n.tags or []) | join('|') }}">
  {{ itemMedia(n, n.title, "16/9") }}
  <div class="card__body">
    <p class="news-card__meta">
      <time>{{ n.date }}</time>
      {% if n.sample %}<span class="status-badge status-badge--planning">サンプル</span>{% endif %}
    </p>
    <h3 class="card__title card__title--sm">{% if n.url %}<a href="{{ n.url }}">{{ n.title }}</a>{% else %}{{ n.title }}{% endif %}</h3>
    {% if n.summary %}<p class="card__text">{{ n.summary }}</p>{% endif %}
    {% if n.tags and n.tags.length %}
    <ul class="news-tags" aria-label="タグ">
      {% for t in n.tags %}<li><a class="news-tag" href="{{ '/news/' | url }}?tag={{ t | urlencode }}">#{{ t }}</a></li>{% endfor %}
    </ul>
    {% endif %}
  </div>
</article>
{% endmacro %}
