---
layout: base.njk
pagination:
  data: services
  size: 1
  alias: service
permalink: "/services/{{ service.id }}/"
eleventyComputed:
  title: "{{ service.name }}"
  description: "{{ service.lead }}"
---
{# サービス紹介ページ（src/_data/services.json の1件ごとに /services/<id>/ を生成） #}
{% from "partials/media.njk" import itemMedia %}
{% from "partials/form-dialog.njk" import formButton, formDialog %}

<section class="section page-sky">
  <div class="container">
    <div class="service-hero">
      <div>
        <div class="section__head" style="margin-bottom:0;">
          <p class="eyebrow">{{ service.group }}</p>
          <h1>{{ service.name }}</h1>
          <p class="service-catch">{{ service.catch }}</p>
          {# intro（段落の配列、\n で改行）があればそれを、なければ lead を表示。lead はページの説明文（description）にも使う #}
          {% if service.intro %}
            {% for para in service.intro %}
            <p class="lead">{% for line in para.split("\n") %}{{ line }}{% if not loop.last %}<br>{% endif %}{% endfor %}</p>
            {% endfor %}
          {% else %}
          <p class="lead">{{ service.lead }}</p>
          {% endif %}
        </div>
        <div class="btn-row">
          {% if service.formUrl %}{{ formButton(service.formUrl, service.cta) }}{% else %}<a class="btn btn--primary" href="{{ '/contact/' | url }}">{{ service.cta }}</a>{% endif %}
        </div>
      </div>
      <div class="service-hero__media">{{ itemMedia(service, service.name) }}</div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <p class="eyebrow">こんな方に</p>
    <h2>こんなときにご相談ください</h2>
    <ul class="check-list">
      {% for w in service.forWhom %}<li>{{ w }}</li>{% endfor %}
    </ul>
  </div>
</section>

<section class="section section--alt">
  <div class="container">
    <p class="eyebrow">サービス内容</p>
    <h2>できること</h2>
    <div class="grid">
      {% for m in service.menu %}
      <div class="card"><div class="card__body">
        <h3 class="card__title card__title--sm">{{ m.title }}</h3>
        <p class="card__text">{{ m.text }}</p>
        {% if m.href %}<a class="card__link" href="{{ m.href | url }}">{{ m.linkText or "詳しく見る" }}</a>{% endif %}
      </div></div>
      {% endfor %}
    </div>
  </div>
</section>

{% if service.consultants %}
<section class="section">
  <div class="container">
    <p class="eyebrow">相談員</p>
    <h2>キャリアコンサルタントの紹介</h2>
    <div class="grid grid--2 consultant-grid">
      {% for c in service.consultants %}
      <div class="card"><div class="card__body">
        <div class="consultant__head">
          {% if c.photo and (("public/images/people/" + c.photo) | fileExists) %}
          <img class="consultant__photo" src="{{ ('/images/people/' + c.photo) | url }}" alt="{{ c.name }}" loading="lazy" decoding="async">
          {% else %}
          <div class="consultant__photo consultant__photo--placeholder" role="img" aria-label="{{ c.name }}（写真準備中）">写真<br>準備中</div>
          {% endif %}
          <h3 class="card__title">{{ c.name }}</h3>
        </div>
        <p class="consultant__label">保有資格</p>
        <ul class="tag-row consultant__tags">
          {% for q in c.qualifications %}<li>{{ q }}</li>{% endfor %}
        </ul>
        <p class="consultant__label">プロフィール</p>
        {% for p in c.profile %}<p class="card__text">{{ p }}</p>{% endfor %}
      </div></div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<section class="section">
  <div class="container">
    <p class="eyebrow">料金</p>
    <h2>料金表</h2>
    {% if service.sample %}
    <p class="notice-box notice-box--caution">この料金表はサンプルです。正式な料金は準備中のため、詳しくはお問い合わせください。</p>
    {% endif %}
    <div class="price-table-wrap">
      <table class="price-table">
        <thead><tr><th scope="col">内容</th><th scope="col">料金（税込）</th><th scope="col">備考</th></tr></thead>
        <tbody>
          {% for p in service.prices %}
          <tr><th scope="row">{{ p.item }}</th><td class="price-table__price">{{ p.price }}</td><td>{{ p.note }}</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% if service.priceNote %}<p class="text-muted" style="margin-top:12px;">{{ service.priceNote }}</p>{% endif %}
  </div>
</section>

{% if service.visit %}
<section class="section">
  <div class="container">
    <p class="eyebrow">専門家による訪問相談</p>
    <h2>{{ service.visit.title }}</h2>
    <p class="lead">{{ service.visit.lead }}</p>
    <div class="grid grid--2">
      {% for v in service.visit.items %}
      <article class="card">
        <div class="card__body">
          <h3 class="card__title">{{ v.name }}</h3>
          <p class="card__text">{{ v.text }}</p>
          <p class="visit-meta">{{ v.meta }}</p>
          <a class="btn btn--outline" href="{{ v.url }}" target="_blank" rel="noopener">くわしく見る（外部サイト）</a>
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<section class="section section--alt">
  <div class="container">
    <p class="eyebrow">ご利用の流れ</p>
    <h2>お問い合わせから始まります</h2>
    <ol class="flow-list">
      {% for step in service.flow %}<li>{{ step }}</li>{% endfor %}
    </ol>
    <div class="btn-row" style="margin-top:28px;">
      {% if service.formUrl %}{{ formButton(service.formUrl, service.cta) }}{% else %}<a class="btn btn--primary" href="{{ '/contact/' | url }}">{{ service.cta }}</a>{% endif %}
    </div>
  </div>
</section>

{# 申し込みフォームがあるサービスは、つながる会と同じく画面に重ねて開く #}
{% if service.formUrl %}{{ formDialog(service.formUrl, service.name + " お申し込み・お問い合わせ") }}{% endif %}
