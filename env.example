# =====================================================================
# これは「見本（テンプレート）」です。このファイルはそのままコミットして構いません。
#
# 使い方:
#   1. このファイルを .env という名前でコピーする（.env はGit管理対象外）
#        Windows PowerShell:  Copy-Item env.example .env
#   2. .env の中の必要な行にだけ、実際の値を書く
#   3. 実際の値（プロジェクトID・APIキー・キーファイルのパス）は
#      .env の外（コード・READMEなど）には絶対に書かない
# =====================================================================

# ---------------------------------------------------------------------
# scripts/lp-image-create.py（Wie for Life LP用・Gemini画像生成）
# ---------------------------------------------------------------------
# 次の「どちらか一方」を設定すれば動きます。かんたんなのは【方法A】です。
#
# 【方法A】Gemini APIキーだけで使う（推奨・設定が1行で済む）
#   Google AI Studio (https://aistudio.google.com/apikey) でキーを取得し、
#   下の行に貼り付ける。GOOGLE_CLOUD_PROJECT は空のままにしておく。
GEMINI_API_KEY=

# 【方法B】Google Cloud (Vertex AI) を使う
#   GOOGLE_CLOUD_PROJECT に値を入れると Vertex AI モードになります。
#   認証は事前に `gcloud auth application-default login` を実行しておけば、
#   キーファイル(GOOGLE_APPLICATION_CREDENTIALS)は不要です。
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# ---------------------------------------------------------------------
# scripts/generate_official_images.py（公式HP用・抽象イラスト生成）
# ---------------------------------------------------------------------
# こちらのスクリプトは次の3つすべてを必要とします（未設定なら生成を実行せず終了）。
# サービスアカウントキー(JSON)は「リポジトリの外」に置き、そのフルパスを指定する。
#   例: C:\Users\chou0\secrets\wie-sa.json
# （どうしてもリポジトリ内に置く場合は secrets/ フォルダへ。.gitignore で除外済み）
# GOOGLE_CLOUD_PROJECT=            （上と共用）
# GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=
